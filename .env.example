# Copy to .env and fill in. Never commit .env.
# docker compose reads it, and the same names work as environment variables on a host
# like Render or Railway.

# --- Database ---
# docker compose creates the database with this password.
POSTGRES_PASSWORD=change-me
# For a hosted database (Neon, Supabase...). Not needed with docker compose.
# A jdbc:postgresql:// URL, or the postgresql://user:password@host/db string your provider shows
# (then the user and password come from the URL and the next two lines are ignored).
DATABASE_URL=jdbc:postgresql://localhost:5432/caredesk
DATABASE_USERNAME=caredesk
DATABASE_PASSWORD=change-me

# --- Backend ---
# Required with the postgres profile. 32+ random characters, for example: openssl rand -base64 48
# Every instance must use the same value.
JWT_SECRET=
# Front ends allowed to call the API directly with a bearer token (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# How rate limits find the visitor's IP. 0 = the connecting address (nothing in front of the app).
# 1 = the last X-Forwarded-For entry, for one proxy you run that appends or overwrites it (nginx).
CLIENT_IP_TRUSTED_HOPS=0
# Or a header your edge overwrites on every request, such as CF-Connecting-IP (wins when present).
CLIENT_IP_HEADER=
# true adds GET /api/public/client-ip, which echoes the proxy headers, to check the two settings above.
CLIENT_IP_DEBUG=false
COOKIE_SECURE=true
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo1234
# ADMIN can edit services and staff; use STAFF for a public demo.
DEMO_ROLE=ADMIN
# Demo only: regenerate the appointments every day so they stay around today. Deletes all appointments.
DEMO_DAILY_RESET=false
API_DOCS_ENABLED=true

# --- Email ---
# "log" prints emails to the server log. "smtp" sends them.
MAIL_MODE=log
MAIL_FROM=Juniper Family Clinic <no-reply@example.com>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Frontend build ---
# Public URL of the site, for canonical and Open Graph tags and the sitemap.
SITE_URL=
# A running API to read services from while prerendering the home page (optional).
PRERENDER_API_URL=
# Leave empty when /api is proxied on the same domain (recommended, keeps the login cookie first-party).
VITE_API_URL=
